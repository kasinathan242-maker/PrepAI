{
  "name": "prepai-server",
  "version": "1.0.0",
  "description": "PrepAI MERN Backend - Express & MongoDB",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seeds/seedData.js",
    "test": "node --test \"src/tests/unit/*.test.js\"",
    "test:integration": "node --test \"src/tests/integration/*.test.js\"",
    "migrate": "node scripts/migrate_v4.js",
    "benchmark": "node src/evals/runFullBenchmark.js",
    "benchmark:compare": "node src/evals/compareModelProviders.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "msedge-tts": "^2.0.9",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.16.0",
    "uuid": "^11.1.0"
  }
}
