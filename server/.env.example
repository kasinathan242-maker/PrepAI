# ============================================================
# PrepAI API — environment configuration
# 100% Custom Models & Hugging Face Open-Source Architecture
# ============================================================

# --- Server & database ---
PORT=7857
APP_ENV=development                 # production refuses to boot with the dev JWT secret
MONGODB_URI=mongodb://127.0.0.1:27017/prepai
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- Auth (15-minute access tokens, rotating refresh tokens) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Custom Models & Hugging Face Models (Exclusively Used for All Purposes) ---
AI_PROVIDER=custom
CUSTOM_MODEL_URL=https://router.huggingface.co/hf-inference/v1   # Hugging Face Inference Router
CUSTOM_API_KEY=                                                  # Bearer token / HF_TOKEN
HF_TOKEN=                                                        # Hugging Face API Token (from huggingface.co/settings/tokens)

# Models from Hugging Face for each specific task:
CUSTOM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct                      # Live Interviewer Dialogue Turn
CUSTOM_EVALUATION_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct           # Background 7-Dimension Rubric Grading & Report Prose
CUSTOM_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct                  # Camera Tutor Webcam Frame Analysis
CUSTOM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5                    # Vector Embeddings & RAG Semantic Memory

# Optional separate custom endpoints (if vision or embeddings run on different servers)
CUSTOM_VISION_URL=
CUSTOM_EMBEDDING_URL=

AI_FALLBACK_PROVIDER=                                            # Disabled (Custom & Hugging Face models only)
AI_TIMEOUT_MS=90000

# --- Embeddings (semantic similarity signal) ---
EMBEDDING_PROVIDER=custom
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Laya decision engine (services/laya-engine) ---
# Disabled by default: No local Python daemons needed. Pure cloud custom models.
LAYA_ENABLED=false
LAYA_MODEL=convaiinnovations/laya
LAYA_SERVICE_URL=http://127.0.0.1:7860
LAYA_TIMEOUT_MS=30000               # background evaluation budget
LAYA_TURN_TIMEOUT_MS=7000           # live interview turn budget

# --- Voice ---
STT_PROVIDER=browser                # Web Speech API in the browser
STT_MODEL=
TTS_PROVIDER=edge                   # Microsoft Edge neural voices via msedge-tts
TTS_MODEL=
